# Postgres connection string (any Postgres works; Supabase or Neon free tier is easiest)
DATABASE_URL=postgresql://user:password@localhost:5432/cargo_concierge

# Model chain, format "provider:model" where provider is google | anthropic | openai
# All three default to google:gemini-2.5-flash if unset
PRIMARY_MODEL=google:gemini-2.5-flash
# Fallback model if the primary call errors or rate-limits
FALLBACK_MODEL=google:gemini-2.5-flash
# Last-resort model after the fallback also fails
SECONDARY_FALLBACK_MODEL=google:gemini-2.5-flash

# Provider API keys: set the one(s) matching the providers in your model chain
# Google AI Studio key (needed for the default google:* models)
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-studio-key
# Anthropic key (only if you use anthropic:* models)
ANTHROPIC_API_KEY=your-anthropic-key
# OpenAI key (only if you use openai:* models)
OPENAI_API_KEY=your-openai-key
